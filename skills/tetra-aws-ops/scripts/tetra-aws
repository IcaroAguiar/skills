#!/usr/bin/env python3
"""Read-only AWS inspection helpers for Tetra services."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
from typing import Any


DEFAULT_PROFILE = "tetra"
DEFAULT_REGION = "us-east-2"
DEFAULT_CLUSTER = "tetra-educacao-ecs-prod"
EXPECTED_ACCOUNT = "780136995828"

SECRET_PATTERNS = [
    re.compile(r"(AKIA|ASIA)[A-Z0-9]{16}"),
    re.compile(r"(?i)(bearer\s+)[A-Za-z0-9._~+/=-]+"),
    re.compile(r"(?i)(authorization['\"]?\s*[:=]\s*['\"]?)[^'\"\s,}]+"),
    re.compile(r"(?i)(password|passwd|secret|token|api[_-]?key|access[_-]?key)(['\"]?\s*[:=]\s*['\"]?)[^'\"\s,}]+"),
    re.compile(r"eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+"),
]


def redact(text: str) -> str:
    redacted = text
    for pattern in SECRET_PATTERNS:
        if pattern.groups >= 2:
            redacted = pattern.sub(lambda m: f"{m.group(1)}{m.group(2)}[REDACTED]", redacted)
        elif pattern.groups == 1:
            redacted = pattern.sub(lambda m: f"{m.group(1)}[REDACTED]", redacted)
        else:
            redacted = pattern.sub("[REDACTED]", redacted)
    return redacted


def run_aws(args: list[str], profile: str, region: str) -> Any:
    env = os.environ.copy()
    env["AWS_PAGER"] = ""
    cmd = ["aws", *args, "--profile", profile, "--region", region, "--output", "json"]
    proc = subprocess.run(cmd, env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if proc.returncode != 0:
        sys.stderr.write(redact(proc.stderr or proc.stdout))
        raise SystemExit(proc.returncode)
    if not proc.stdout.strip():
        return None
    return json.loads(proc.stdout)


def print_json(data: Any) -> None:
    print(json.dumps(data, indent=2, sort_keys=True))


def service_arn_to_name(arn_or_name: str) -> str:
    return arn_or_name.rsplit("/", 1)[-1]


def first_service_name(service: str, profile: str, region: str, cluster: str) -> str:
    if service.startswith("arn:"):
        return service
    services = run_aws(["ecs", "list-services", "--cluster", cluster], profile, region).get("serviceArns", [])
    exact = [arn for arn in services if service_arn_to_name(arn) == service]
    if exact:
        return exact[0]
    contains = [arn for arn in services if service in service_arn_to_name(arn)]
    if len(contains) == 1:
        return contains[0]
    if len(contains) > 1:
        names = "\n".join(service_arn_to_name(arn) for arn in contains)
        raise SystemExit(f"Ambiguous service '{service}'. Matches:\n{names}")
    return service


def describe_service(service: str, profile: str, region: str, cluster: str) -> dict[str, Any]:
    resolved = first_service_name(service, profile, region, cluster)
    data = run_aws(["ecs", "describe-services", "--cluster", cluster, "--services", resolved], profile, region)
    failures = data.get("failures") or []
    if failures:
        print_json({"failures": failures})
        raise SystemExit(2)
    return data["services"][0]


def command_whoami(args: argparse.Namespace) -> None:
    identity = run_aws(["sts", "get-caller-identity"], args.profile, args.region)
    identity["expectedAccount"] = EXPECTED_ACCOUNT
    identity["accountMatchesExpected"] = identity.get("Account") == EXPECTED_ACCOUNT
    print_json(identity)


def command_clusters(args: argparse.Namespace) -> None:
    print_json(run_aws(["ecs", "list-clusters"], args.profile, args.region))


def command_services(args: argparse.Namespace) -> None:
    data = run_aws(["ecs", "list-services", "--cluster", args.cluster], args.profile, args.region)
    print_json({"cluster": args.cluster, "services": [service_arn_to_name(arn) for arn in data.get("serviceArns", [])]})


def summarize_deployment(dep: dict[str, Any]) -> dict[str, Any]:
    return {
        "id": dep.get("id"),
        "status": dep.get("status"),
        "rolloutState": dep.get("rolloutState"),
        "rolloutStateReason": dep.get("rolloutStateReason"),
        "taskDefinition": dep.get("taskDefinition"),
        "desiredCount": dep.get("desiredCount"),
        "pendingCount": dep.get("pendingCount"),
        "runningCount": dep.get("runningCount"),
        "failedTasks": dep.get("failedTasks"),
        "createdAt": str(dep.get("createdAt")) if dep.get("createdAt") else None,
        "updatedAt": str(dep.get("updatedAt")) if dep.get("updatedAt") else None,
    }


def command_service(args: argparse.Namespace) -> None:
    svc = describe_service(args.service, args.profile, args.region, args.cluster)
    output = {
        "serviceName": svc.get("serviceName"),
        "clusterArn": svc.get("clusterArn"),
        "status": svc.get("status"),
        "desiredCount": svc.get("desiredCount"),
        "runningCount": svc.get("runningCount"),
        "pendingCount": svc.get("pendingCount"),
        "taskDefinition": svc.get("taskDefinition"),
        "deployments": [summarize_deployment(dep) for dep in svc.get("deployments", [])],
        "recentEvents": [
            {"createdAt": str(event.get("createdAt")), "message": redact(event.get("message", ""))}
            for event in svc.get("events", [])[: args.events]
        ],
    }
    print_json(output)


def command_tasks(args: argparse.Namespace) -> None:
    service = first_service_name(args.service, args.profile, args.region, args.cluster)
    list_args = [
        "ecs",
        "list-tasks",
        "--cluster",
        args.cluster,
        "--service-name",
        service_arn_to_name(service),
        "--desired-status",
        args.desired,
    ]
    task_arns = run_aws(list_args, args.profile, args.region).get("taskArns", [])
    if not task_arns:
        print_json({"cluster": args.cluster, "service": service_arn_to_name(service), "tasks": []})
        return
    data = run_aws(["ecs", "describe-tasks", "--cluster", args.cluster, "--tasks", *task_arns], args.profile, args.region)
    tasks = []
    for task in data.get("tasks", []):
        tasks.append(
            {
                "taskArn": task.get("taskArn"),
                "lastStatus": task.get("lastStatus"),
                "desiredStatus": task.get("desiredStatus"),
                "healthStatus": task.get("healthStatus"),
                "taskDefinitionArn": task.get("taskDefinitionArn"),
                "createdAt": str(task.get("createdAt")) if task.get("createdAt") else None,
                "startedAt": str(task.get("startedAt")) if task.get("startedAt") else None,
                "stoppedAt": str(task.get("stoppedAt")) if task.get("stoppedAt") else None,
                "stoppedReason": redact(task.get("stoppedReason", "")),
                "containers": [
                    {
                        "name": c.get("name"),
                        "lastStatus": c.get("lastStatus"),
                        "exitCode": c.get("exitCode"),
                        "reason": redact(c.get("reason", "")),
                        "healthStatus": c.get("healthStatus"),
                    }
                    for c in task.get("containers", [])
                ],
            }
        )
    print_json({"cluster": args.cluster, "service": service_arn_to_name(service), "tasks": tasks})


def sanitize_task_definition(task_def: dict[str, Any]) -> dict[str, Any]:
    containers = []
    for c in task_def.get("containerDefinitions", []):
        log_options = (c.get("logConfiguration") or {}).get("options") or {}
        containers.append(
            {
                "name": c.get("name"),
                "image": c.get("image"),
                "command": c.get("command"),
                "entryPoint": c.get("entryPoint"),
                "cpu": c.get("cpu"),
                "memory": c.get("memory"),
                "memoryReservation": c.get("memoryReservation"),
                "portMappings": c.get("portMappings", []),
                "environmentNames": sorted(item.get("name") for item in c.get("environment", []) if item.get("name")),
                "secretNames": sorted(item.get("name") for item in c.get("secrets", []) if item.get("name")),
                "logDriver": (c.get("logConfiguration") or {}).get("logDriver"),
                "logGroup": log_options.get("awslogs-group"),
                "logStreamPrefix": log_options.get("awslogs-stream-prefix"),
            }
        )
    return {
        "taskDefinitionArn": task_def.get("taskDefinitionArn"),
        "family": task_def.get("family"),
        "revision": task_def.get("revision"),
        "status": task_def.get("status"),
        "requiresCompatibilities": task_def.get("requiresCompatibilities"),
        "cpu": task_def.get("cpu"),
        "memory": task_def.get("memory"),
        "networkMode": task_def.get("networkMode"),
        "taskRoleArn": task_def.get("taskRoleArn"),
        "executionRoleArn": task_def.get("executionRoleArn"),
        "containers": containers,
    }


def get_task_definition_for_service(args: argparse.Namespace) -> dict[str, Any]:
    svc = describe_service(args.service, args.profile, args.region, args.cluster)
    data = run_aws(["ecs", "describe-task-definition", "--task-definition", svc["taskDefinition"]], args.profile, args.region)
    return data["taskDefinition"]


def command_taskdef(args: argparse.Namespace) -> None:
    print_json(sanitize_task_definition(get_task_definition_for_service(args)))


def command_logs(args: argparse.Namespace) -> None:
    task_def = get_task_definition_for_service(args)
    sanitized = sanitize_task_definition(task_def)
    candidates = [
        c for c in sanitized.get("containers", []) if c.get("logGroup")
    ]
    if not candidates:
        raise SystemExit("No awslogs log group found in task definition.")
    group = args.log_group or candidates[0]["logGroup"]
    since = dt.datetime.now(dt.UTC) - dt.timedelta(minutes=args.minutes)
    start_ms = int(since.timestamp() * 1000)
    data = run_aws(
        [
            "logs",
            "filter-log-events",
            "--log-group-name",
            group,
            "--start-time",
            str(start_ms),
            "--limit",
            str(args.limit),
        ],
        args.profile,
        args.region,
    )
    events = []
    for event in data.get("events", []):
        ts = dt.datetime.fromtimestamp(event["timestamp"] / 1000, dt.UTC).isoformat()
        events.append(
            {
                "timestamp": ts,
                "logStreamName": event.get("logStreamName"),
                "message": redact(event.get("message", "")),
            }
        )
    print_json({"logGroup": group, "minutes": args.minutes, "events": events})


def add_common(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--profile", default=DEFAULT_PROFILE)
    parser.add_argument("--region", default=DEFAULT_REGION)
    parser.add_argument("--cluster", default=DEFAULT_CLUSTER)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Read-only AWS inspection helpers for Tetra services.")
    sub = parser.add_subparsers(dest="command", required=True)

    for name, handler in [
        ("whoami", command_whoami),
        ("clusters", command_clusters),
        ("services", command_services),
    ]:
        p = sub.add_parser(name)
        add_common(p)
        p.set_defaults(func=handler)

    p = sub.add_parser("service")
    add_common(p)
    p.add_argument("service")
    p.add_argument("--events", type=int, default=10)
    p.set_defaults(func=command_service)

    p = sub.add_parser("tasks")
    add_common(p)
    p.add_argument("service")
    p.add_argument("--desired", choices=["RUNNING", "STOPPED"], default="RUNNING")
    p.set_defaults(func=command_tasks)

    p = sub.add_parser("taskdef")
    add_common(p)
    p.add_argument("service")
    p.set_defaults(func=command_taskdef)

    p = sub.add_parser("logs")
    add_common(p)
    p.add_argument("service")
    p.add_argument("--minutes", type=int, default=30)
    p.add_argument("--limit", type=int, default=50)
    p.add_argument("--log-group")
    p.set_defaults(func=command_logs)

    return parser


def main() -> None:
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
