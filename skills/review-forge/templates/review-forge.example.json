{
  "$schema": "./review-forge.schema.json",
  "rules": {
    "magic-string": true,
    "duplicated-literal": true,
    "static-heavy-ui-import-without-lazy-boundary": true
  },
  "severities": {
    "static-heavy-ui-import-without-lazy-boundary": "low"
  },
  "appType": "public-api",
  "thresholds": {
    "largeFileLines": 500,
    "veryLargeFileLines": 1000,
    "largeRefactorLines": 800,
    "largeRefactorChangedLines": 50,
    "longFunctionLines": 80,
    "veryLongFunctionLines": 140,
    "highImportCount": 25,
    "wideConstructorParams": 8
  },
  "ignorePaths": [
    "dist/**",
    "coverage/**",
    "generated/**"
  ],
  "customQuestions": [
    "Esta mudanca afeta LGPD, privacidade, escopo de tenant ou dados sensiveis?",
    "Existe consumidor externo ou mobile que dependa deste contrato?"
  ],
  "domainCatalogs": [
    "lgpd",
    "finance",
    "education"
  ],
  "customDomainQuestions": {
    "marketplace": [
      "Marketplace: split de pagamento, disputa, comissao e repasse preservam auditoria, idempotencia e reconciliacao?"
    ]
  },
  "dastTargets": [],
  "performanceTargets": [],
  "a11yTargets": [],
  "e2eCoverageReportPaths": [
    "coverage/e2e/coverage-summary.json"
  ],
  "contractTestReportPaths": [
    "reports/contracts/openapi-results.json",
    "reports/contracts/graphql-results.json"
  ],
  "criticalFlowKeywords": [
    "auth",
    "checkout",
    "cart",
    "tenant",
    "permission"
  ],
  "e2eCoverageMin": 80,
  "contractPassRateMin": 100,
  "graphqlBaseSchema": "schema.graphql",
  "graphqlHeadSchema": "schema.graphql",
  "bundleStatsPath": "dist/stats.json",
  "coverageLinesMin": 85,
  "reviewFeedbackPath": "docs/ai/review-forge-feedback.json",
  "externalToolTimeoutMs": 60000
}
