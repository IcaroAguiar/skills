{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review Forge real-diff corpus",
  "type": "object",
  "required": ["version", "status", "cases"],
  "properties": {
    "version": { "const": 1 },
    "status": { "enum": ["discovery", "adjudicated"] },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "mode", "category", "language", "size", "repository", "prUrl", "license", "retrievalStatus", "retrievedAt", "candidate", "diffSha256", "stats", "evidenceUrls", "projectChecks", "documentationSources"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "mode": { "enum": ["discovery", "adjudicated"] },
          "category": { "enum": ["simplification", "semantics", "documentation"] },
          "language": { "type": "string", "minLength": 2 },
          "size": { "enum": ["small", "medium", "large"] },
          "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
          "prUrl": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+$" },
          "license": { "type": "string", "minLength": 3 },
          "retrievalStatus": { "const": "verified" },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "candidate": { "$ref": "#/$defs/range" },
          "accepted": { "$ref": "#/$defs/range" },
          "acceptedFinality": {
            "type": "object",
            "required": ["kind", "sha"],
            "properties": {
              "kind": { "enum": ["pr-head", "merge-commit"] },
              "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            },
            "additionalProperties": false
          },
          "acceptedDiffSha256": { "type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$" },
          "acceptedStats": {
            "type": "object",
            "required": ["files", "additions", "deletions"],
            "properties": {
              "files": { "type": "integer", "minimum": 0 },
              "additions": { "type": "integer", "minimum": 0 },
              "deletions": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "diffSha256": { "type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$" },
          "stats": {
            "type": "object",
            "required": ["files", "additions", "deletions"],
            "properties": {
              "files": { "type": "integer", "minimum": 0 },
              "additions": { "type": "integer", "minimum": 0 },
              "deletions": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "evidenceUrls": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://github\\.com/" } },
          "maintainerEvidenceUrls": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://github\\.com/" } },
          "acceptedEvidenceUrls": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://github\\.com/" } },
          "groundTruthRef": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+\\.json$" },
          "groundTruthSha256": { "type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$" },
          "projectChecks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
          "documentationSources": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "adjudicated" } }, "required": ["mode"] },
            "then": { "required": ["accepted", "acceptedFinality", "acceptedDiffSha256", "acceptedStats", "acceptedEvidenceUrls", "groundTruthRef", "groundTruthSha256", "maintainerEvidenceUrls"] }
          }
        ]
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": ["baseSha", "headSha"],
      "properties": {
        "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    }
  }
}
