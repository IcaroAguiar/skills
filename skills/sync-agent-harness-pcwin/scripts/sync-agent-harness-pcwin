#!/usr/bin/env bash

set -euo pipefail

remote_host="${1:-pcwin-qualityflow}"
remote_home="${REMOTE_HARNESS_HOME:-/home/icaro}"
remote_windows_home="${REMOTE_WINDOWS_HOME:-/mnt/c/Users/Icaro}"
remote_powershell="${REMOTE_POWERSHELL:-/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe}"

control_dir=$(mktemp -d "/tmp/pcw.XXXXXX")
control_path="$control_dir/ssh-control"

cleanup() {
  ssh -S "$control_path" -O exit "$remote_host" >/dev/null 2>&1 || true
  rmdir "$control_dir" 2>/dev/null || true
}
trap cleanup EXIT

connected=false
for attempt in 1 2 3 4 5; do
  if ssh -M -S "$control_path" -o ControlPersist=60 -o ConnectTimeout=10 -fnN "$remote_host"; then
    connected=true
    break
  fi
done

if [[ "$connected" != true ]]; then
  printf 'Unable to establish the PCwin SSH control connection: %s\n' "$remote_host" >&2
  exit 1
fi

ssh_remote=(ssh -S "$control_path" "$remote_host")
rsync_ssh="ssh -S $control_path"

require_path() {
  if [[ ! -e "$1" ]]; then
    printf 'Required source is missing: %s\n' "$1" >&2
    exit 1
  fi
}

require_path "$HOME/.agents/skills"
require_path "$HOME/.agents/.skill-lock.json"
require_path "$HOME/.codex/agents"
require_path "$HOME/.codex/AGENTS.md"
require_path "$HOME/.codex/hooks"
require_path "$HOME/.codex/hooks.json"

"${ssh_remote[@]}" "mkdir -p '$remote_home/.agents' '$remote_home/.codex/agents' '$remote_home/.claude/agents' '$remote_home/.cursor/agents' '$remote_home/.config/opencode/agents'"
"${ssh_remote[@]}" "test -d '$remote_windows_home' && test -x '$remote_powershell' && mkdir -p '$remote_windows_home/.agents' '$remote_windows_home/.codex/agents' '$remote_windows_home/.claude/agents' '$remote_windows_home/.cursor/agents' '$remote_windows_home/.config/opencode/agents'"

# The Mac is authoritative. --copy-links materializes the one skill that points
# at a Mac-only repository so the remote catalog has no broken absolute links.
rsync -e "$rsync_ssh" -a --copy-links --delete --exclude='.DS_Store' --exclude='.system/' \
  "$HOME/.agents/skills/" \
  "$remote_host:$remote_home/.agents/skills/"
rsync -e "$rsync_ssh" -a "$HOME/.agents/.skill-lock.json" \
  "$remote_host:$remote_home/.agents/.skill-lock.json"

rsync -e "$rsync_ssh" -a --delete --exclude='.DS_Store' \
  "$HOME/.codex/agents/" \
  "$remote_host:$remote_home/.codex/agents/"
rsync -e "$rsync_ssh" -a "$HOME/.codex/AGENTS.md" \
  "$remote_host:$remote_home/.codex/AGENTS.md"
rsync -e "$rsync_ssh" -a --delete \
  --exclude='__pycache__/' --exclude='*.pyc' --exclude='*.bak*' --exclude='*.backup*' \
  "$HOME/.codex/hooks/" \
  "$remote_host:$remote_home/.codex/hooks/"
rsync -e "$rsync_ssh" -a "$HOME/.codex/hooks.json" \
  "$remote_host:$remote_home/.codex/hooks.source.json"
"${ssh_remote[@]}" \
  "/usr/bin/python3 '$remote_home/.codex/hooks/render_portable_hooks.py' \
  --source '$remote_home/.codex/hooks.source.json' \
  --destination '$remote_home/.codex/hooks.json' \
  --home '$remote_home'"

for adapter_agents in \
  ".claude/agents" \
  ".cursor/agents" \
  ".config/opencode/agents"
do
  if [[ -d "$HOME/$adapter_agents" ]]; then
    rsync -e "$rsync_ssh" -a --delete --exclude='.DS_Store' \
      "$HOME/$adapter_agents/" \
      "$remote_host:$remote_home/$adapter_agents/"
  fi
done

# Codex remote-control runs as a native Windows process, even when its project
# path is a WSL UNC path. DrvFS does not reliably permit rsync's POSIX temp-file
# behavior in the Windows profile, so native Robocopy mirrors the WSL copy.
"${ssh_remote[@]}" "WSL_HOME='$remote_home' WINDOWS_HOME='$remote_windows_home' POWERSHELL_EXE='$remote_powershell' bash -s" <<'WINDOWS_COPY'
set -euo pipefail

mirror_with_robocopy() {
  local source_wsl="$1"
  local destination_wsl="$2"
  local preserve_system="${3:-false}"
  local source_win destination_win

  source_win=$(wslpath -w "$source_wsl")
  destination_win=$(wslpath -w "$destination_wsl")

  WSLENV="${WSLENV:+$WSLENV:}SYNC_SOURCE:SYNC_DESTINATION:SYNC_PRESERVE_SYSTEM" \
  SYNC_SOURCE="$source_win" \
  SYNC_DESTINATION="$destination_win" \
  SYNC_PRESERVE_SYSTEM="$preserve_system" \
  "$POWERSHELL_EXE" -NoProfile -NonInteractive -Command '
    $ErrorActionPreference = "Stop"
    $source = $env:SYNC_SOURCE
    $destination = $env:SYNC_DESTINATION
    $preserveSystem = $env:SYNC_PRESERVE_SYSTEM -eq "true"
    $savedSystem = $null
    if ($preserveSystem) {
      $systemPath = Join-Path $destination ".system"
      if (Test-Path -LiteralPath $systemPath) {
        $savedSystem = Join-Path ([IO.Path]::GetTempPath()) ("codex-system-" + [guid]::NewGuid())
        Move-Item -LiteralPath $systemPath -Destination $savedSystem
      }
    }
    try {
      New-Item -ItemType Directory -Force -Path $destination | Out-Null
      & robocopy.exe $source $destination /MIR /R:2 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null
      if ($LASTEXITCODE -ge 8) { throw "Robocopy failed with exit code $LASTEXITCODE" }
    } finally {
      if ($savedSystem -and (Test-Path -LiteralPath $savedSystem)) {
        Move-Item -LiteralPath $savedSystem -Destination (Join-Path $destination ".system")
      }
    }
  ' </dev/null
}

copy_file_native() {
  local source_win destination_win
  source_win=$(wslpath -w "$1")
  destination_win=$(wslpath -w "$2")
  WSLENV="${WSLENV:+$WSLENV:}SYNC_SOURCE:SYNC_DESTINATION" \
  SYNC_SOURCE="$source_win" \
  SYNC_DESTINATION="$destination_win" \
  "$POWERSHELL_EXE" -NoProfile -NonInteractive -Command \
    '$ErrorActionPreference="Stop"; Copy-Item -LiteralPath $env:SYNC_SOURCE -Destination $env:SYNC_DESTINATION -Force' </dev/null
}

mirror_with_robocopy "$WSL_HOME/.agents/skills" "$WINDOWS_HOME/.agents/skills" true
mirror_with_robocopy "$WSL_HOME/.codex/agents" "$WINDOWS_HOME/.codex/agents"
mirror_with_robocopy "$WSL_HOME/.codex/hooks" "$WINDOWS_HOME/.codex/hooks"
copy_file_native "$WSL_HOME/.agents/.skill-lock.json" "$WINDOWS_HOME/.agents/.skill-lock.json"
copy_file_native "$WSL_HOME/.codex/AGENTS.md" "$WINDOWS_HOME/.codex/AGENTS.md"

for adapter_agents in \
  ".claude/agents" \
  ".cursor/agents" \
  ".config/opencode/agents"
do
  if [[ -d "$WSL_HOME/$adapter_agents" ]]; then
    mirror_with_robocopy "$WSL_HOME/$adapter_agents" "$WINDOWS_HOME/$adapter_agents"
  fi
done
WINDOWS_COPY

"${ssh_remote[@]}" "WINDOWS_HOME='$remote_windows_home' POWERSHELL_EXE='$remote_powershell' bash -s" <<'WINDOWS_SETUP'
set -euo pipefail

codex_skills="$WINDOWS_HOME/.codex/skills"
canonical_skills="$WINDOWS_HOME/.agents/skills"

# Preserve the Windows runtime-owned system catalog inside the canonical tree.
if [[ -d "$codex_skills/.system" && ! -e "$canonical_skills/.system" ]]; then
  mv "$codex_skills/.system" "$canonical_skills/.system"
fi

# A native Windows junction is required here. WSL-created Linux symlinks on
# DrvFS are not a reliable catalog surface for a Win32 Codex process.
ensure_windows_junction() {
  local link_wsl="$1"
  local target_wsl="$2"
  local drive link_win target_win

  case "$link_wsl" in
    /mnt/?/*)
      drive=${link_wsl#/mnt/}
      drive=${drive%%/*}
      link_win="${drive^^}:${link_wsl#"/mnt/$drive"}"
      ;;
    *)
      printf 'Unsupported Windows junction path: %s\n' "$link_wsl" >&2
      exit 1
      ;;
  esac

  case "$target_wsl" in
    /mnt/?/*)
      drive=${target_wsl#/mnt/}
      drive=${drive%%/*}
      target_win="${drive^^}:${target_wsl#"/mnt/$drive"}"
      ;;
    *)
      printf 'Unsupported Windows junction target: %s\n' "$target_wsl" >&2
      exit 1
      ;;
  esac

  WSLENV="${WSLENV:+$WSLENV:}JUNCTION_LINK:JUNCTION_TARGET" \
  JUNCTION_LINK="$link_win" \
  JUNCTION_TARGET="$target_win" \
  "$POWERSHELL_EXE" -NoProfile -NonInteractive -Command \
    '$ErrorActionPreference="Stop"; $item=Get-Item -LiteralPath $env:JUNCTION_LINK -Force -ErrorAction SilentlyContinue; if ($null -ne $item) { if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) { throw "Refusing to replace non-junction path: $($env:JUNCTION_LINK)" }; $resolved=$item.Target; if ($resolved -is [array]) { $resolved=$resolved[0] }; $resolved=[IO.Path]::GetFullPath($resolved).TrimEnd("\"); $expected=[IO.Path]::GetFullPath($env:JUNCTION_TARGET).TrimEnd("\"); if (-not [string]::Equals($resolved,$expected,[StringComparison]::OrdinalIgnoreCase)) { throw "Refusing mismatched junction: $($env:JUNCTION_LINK) -> $resolved" }; exit 0 }; New-Item -ItemType Junction -Path $env:JUNCTION_LINK -Target $env:JUNCTION_TARGET | Out-Null' </dev/null
}

ensure_windows_junction "$codex_skills" "$canonical_skills"
ensure_windows_junction "$WINDOWS_HOME/.claude/skills" "$canonical_skills"
ensure_windows_junction "$WINDOWS_HOME/.cursor/skills" "$canonical_skills"
ensure_windows_junction "$WINDOWS_HOME/.config/opencode/skills" "$canonical_skills"
WINDOWS_SETUP

"${ssh_remote[@]}" "REMOTE_HOME='$remote_home' bash -s" <<'REMOTE_SETUP'
set -euo pipefail

ensure_link() {
  local link_path="$1"
  local target="$2"

  if [[ -e "$link_path" && ! -L "$link_path" ]]; then
    printf 'Refusing to replace non-symlink path: %s\n' "$link_path" >&2
    exit 1
  fi

  mkdir -p "$(dirname "$link_path")"
  ln -sfn "$target" "$link_path"
}

ensure_link "$REMOTE_HOME/.agents/AGENTS.md" "../.codex/AGENTS.md"
ensure_link "$REMOTE_HOME/.claude/skills" "../.agents/skills"
ensure_link "$REMOTE_HOME/.cursor/skills" "../.agents/skills"
ensure_link "$REMOTE_HOME/.config/opencode/skills" "../../.agents/skills"

# Codex owns .codex/skills/.system and may update it at runtime. Keep that
# directory real, while linking every user skill to the shared catalog.
if [[ -L "$REMOTE_HOME/.codex/skills" ]]; then
  unlink "$REMOTE_HOME/.codex/skills"
fi
mkdir -p "$REMOTE_HOME/.codex/skills"

if [[ -d "$REMOTE_HOME/.agents/skills/.system" && ! -e "$REMOTE_HOME/.codex/skills/.system" ]]; then
  mv "$REMOTE_HOME/.agents/skills/.system" "$REMOTE_HOME/.codex/skills/.system"
fi

for skill_dir in "$REMOTE_HOME/.agents/skills"/*; do
  [[ -d "$skill_dir" ]] || continue
  skill_name=$(basename "$skill_dir")
  ensure_link "$REMOTE_HOME/.codex/skills/$skill_name" "../../.agents/skills/$skill_name"
done

while IFS= read -r -d '' codex_skill_link; do
  if [[ ! -e "$codex_skill_link" ]]; then
    unlink "$codex_skill_link"
  fi
done < <(find "$REMOTE_HOME/.codex/skills" -mindepth 1 -maxdepth 1 -type l -print0)
REMOTE_SETUP

"${ssh_remote[@]}" "REMOTE_HOME='$remote_home' bash -s" <<'REMOTE_LEDGER_SETUP'
set -euo pipefail

if ! codex mcp get notion >/dev/null 2>&1; then
  codex mcp add notion --url https://mcp.notion.com/mcp >/dev/null
fi

if ! codex mcp get obsidian-brain >/dev/null 2>&1; then
  codex mcp add obsidian-brain \
    --env HARNESS_BRAIN_MODE=queue \
    --env HARNESS_LEDGER_STATE_DIR="$REMOTE_HOME/.agents/harness-ledger" \
    -- /usr/bin/python3 "$REMOTE_HOME/.codex/hooks/brain_mcp_server.py" >/dev/null
fi

/usr/bin/python3 "$REMOTE_HOME/.codex/hooks/codex_trust_installed_hooks.py" \
  --codex "$(command -v codex)" \
  --cwd "$REMOTE_HOME" \
  --expected-config "$REMOTE_HOME/.codex/hooks.json" \
  --json >/tmp/harness-hook-trust.json
REMOTE_LEDGER_SETUP

"${ssh_remote[@]}" "REMOTE_HOME='$remote_home' bash -s" <<'REMOTE_VERIFY'
set -euo pipefail

skill_count=$(find "$REMOTE_HOME/.agents/skills" -mindepth 1 -maxdepth 1 -type d | wc -l)
agent_count=$(find "$REMOTE_HOME/.codex/agents" -maxdepth 1 -type f -name '*.toml' | wc -l)

test -f "$REMOTE_HOME/.agents/skills/improve/SKILL.md"
test -f "$REMOTE_HOME/.agents/skills/grilling/SKILL.md"
grep -q 'request_user_input' "$REMOTE_HOME/.agents/skills/grilling/SKILL.md"
test -d "$REMOTE_HOME/.codex/skills/.system"
test -L "$REMOTE_HOME/.codex/skills/improve"
test -L "$REMOTE_HOME/.codex/skills/grilling"
test -L "$REMOTE_HOME/.claude/skills"
test -L "$REMOTE_HOME/.cursor/skills"
test -L "$REMOTE_HOME/.config/opencode/skills"
test -f "$REMOTE_HOME/.codex/hooks/notion_task_guard.py"
test -f "$REMOTE_HOME/.codex/hooks/brain_memory_guard.py"
test -f "$REMOTE_HOME/.codex/hooks/brain_mcp_server.py"
test -f "$REMOTE_HOME/.codex/hooks.json"
codex mcp get notion >/dev/null
codex mcp get obsidian-brain >/dev/null
grep -q '"trusted":' /tmp/harness-hook-trust.json

printf 'Remote harness synchronized: %s skills, %s Codex agents\n' "$skill_count" "$agent_count"
printf 'Canonical skills: %s\n' "$REMOTE_HOME/.agents/skills"
printf 'Lifecycle hooks: trusted; Notion and Obsidian Brain MCPs: configured\n'
REMOTE_VERIFY

"${ssh_remote[@]}" "WINDOWS_HOME='$remote_windows_home' bash -s" <<'WINDOWS_VERIFY'
set -euo pipefail

skill_count=$(find "$WINDOWS_HOME/.agents/skills" -mindepth 1 -maxdepth 1 -type d ! -name '.system' | wc -l)
agent_count=$(find "$WINDOWS_HOME/.codex/agents" -maxdepth 1 -type f -name '*.toml' | wc -l)

test -f "$WINDOWS_HOME/.agents/skills/improve/SKILL.md"
test -f "$WINDOWS_HOME/.agents/skills/grilling/SKILL.md"
grep -q 'request_user_input' "$WINDOWS_HOME/.agents/skills/grilling/SKILL.md"
test -d "$WINDOWS_HOME/.agents/skills/.system"
test -f "$WINDOWS_HOME/.codex/skills/improve/SKILL.md"
test -f "$WINDOWS_HOME/.codex/skills/grilling/SKILL.md"
test -f "$WINDOWS_HOME/.claude/skills/improve/SKILL.md"
test -f "$WINDOWS_HOME/.cursor/skills/improve/SKILL.md"
test -f "$WINDOWS_HOME/.config/opencode/skills/improve/SKILL.md"

printf 'Windows remote-control harness synchronized: %s user skills, %s Codex agents\n' "$skill_count" "$agent_count"
printf 'Canonical Windows skills: %s\n' "$WINDOWS_HOME/.agents/skills"
WINDOWS_VERIFY
