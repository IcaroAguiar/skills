{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://split-engineering.local/run.schema.json",
  "title": "Split Engineering run ledger",
  "type": "object",
  "required": ["schemaVersion", "runId", "title", "state", "graphVersion", "plan", "nodes", "evidence", "artifacts", "stateHistory", "graphVersions", "report"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "state": { "enum": ["DRAFT", "PLAN_PENDING_USER", "APPROVED", "EXECUTING", "INTEGRATING", "TESTING", "REPORTING", "AWAITING_REVIEW_DECISION", "BLOCKED", "COMPLETE", "CANCELLED"] },
    "graphVersion": { "type": "integer", "minimum": 1 },
    "plan": {
      "type": "object",
      "required": ["objective", "nonGoals", "constraints", "authority", "approval"],
      "properties": {
        "objective": { "type": "string" },
        "nonGoals": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "authority": { "type": "object" },
        "approval": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "state", "dependencies", "ownership", "acceptanceCriteria", "reasoning", "attempts", "maxAttempts", "receipts", "stateHistory"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["scout", "execute", "integrate", "test", "report"] },
          "state": { "enum": ["PROPOSED", "READY", "DISCUSSING", "RUNNING", "EVIDENCE_PENDING", "PASSED", "FAILED", "REOPENED", "BLOCKED", "INVALIDATED"] },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "ownership": { "type": "array", "items": { "type": "string" } },
          "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
          "reasoning": { "enum": ["low", "medium", "high", "xhigh"] },
          "attempts": { "type": "integer", "minimum": 0 },
          "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
          "receipts": { "type": "array", "items": { "type": "string" } },
          "stateHistory": { "type": "array" }
        },
        "additionalProperties": true
      }
    },
    "evidence": { "type": "array" },
    "artifacts": { "type": "array" },
    "stateHistory": { "type": "array" },
    "graphVersions": { "type": "array", "minItems": 1 },
    "report": {
      "type": "object",
      "required": ["path", "lastRenderedAt", "presentation"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "lastRenderedAt": { "type": ["string", "null"] },
        "presentation": { "type": ["object", "null"] }
      }
    },
    "completionReceipt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/completionReceipt" }] },
    "extensions": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "COMPLETE" } }, "required": ["state"] },
      "then": { "required": ["completionReceipt"], "properties": { "completionReceipt": { "$ref": "#/$defs/completionReceipt" } } }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["fingerprint", "mode", "repositoryId", "schemaVersion", "base"],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mode": { "enum": ["commit", "index", "worktree"] },
        "repositoryId": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "base": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "commit" } }, "required": ["mode"] },
          "then": { "required": ["head"] }
        }
      ],
      "additionalProperties": true
    },
    "gateReceipt": {
      "type": "object",
      "required": ["status", "receiptIds"],
      "properties": {
        "status": { "enum": ["PASS", "NOT_APPLICABLE", "BLOCKED"] },
        "receiptIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "completionReceipt": {
      "type": "object",
      "required": ["id", "kind", "candidate", "graphVersion", "gates"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["CODE_REVIEW_APPROVAL", "USER_RISK_ACCEPTANCE"] },
        "candidate": { "$ref": "#/$defs/candidate" },
        "graphVersion": { "type": "integer", "minimum": 1 },
        "codeReviewReceiptId": { "type": "string", "minLength": 1 },
        "gates": {
          "type": "object",
          "required": ["CORRECTNESS", "SIMPLIFICATION", "SEMANTICS", "DOCUMENTATION", "VERIFICATION"],
          "properties": {
            "CORRECTNESS": { "$ref": "#/$defs/gateReceipt" },
            "SIMPLIFICATION": { "$ref": "#/$defs/gateReceipt" },
            "SEMANTICS": { "$ref": "#/$defs/gateReceipt" },
            "DOCUMENTATION": { "$ref": "#/$defs/gateReceipt" },
            "VERIFICATION": { "$ref": "#/$defs/gateReceipt" }
          },
          "additionalProperties": false
        },
        "userAcceptance": {
          "type": "object",
          "required": ["by", "at", "statement", "explicit", "acceptedRiskReceiptIds"],
          "properties": {
            "by": { "type": "string", "minLength": 1 },
            "at": { "type": "string", "minLength": 1 },
            "statement": { "type": "string", "minLength": 1 },
            "explicit": { "const": true },
            "acceptedRiskReceiptIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "CODE_REVIEW_APPROVAL" } }, "required": ["kind"] },
          "then": {
            "required": ["codeReviewReceiptId"],
            "properties": {
              "candidate": { "properties": { "mode": { "const": "commit" } } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "USER_RISK_ACCEPTANCE" } }, "required": ["kind"] },
          "then": { "required": ["userAcceptance"] }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
