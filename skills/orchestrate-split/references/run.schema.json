{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://split-engineering.local/run.schema.json",
  "title": "Split Engineering run ledger",
  "type": "object",
  "required": ["schemaVersion", "runId", "title", "state", "graphVersion", "plan", "nodes", "evidence", "artifacts", "stateHistory", "graphVersions", "report"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "state": { "enum": ["DRAFT", "PLAN_PENDING_USER", "APPROVED", "EXECUTING", "INTEGRATING", "TESTING", "REPORTING", "AWAITING_REVIEW_DECISION", "BLOCKED", "COMPLETE", "CANCELLED"] },
    "graphVersion": { "type": "integer", "minimum": 1 },
    "plan": {
      "type": "object",
      "required": ["objective", "nonGoals", "constraints", "authority", "approval"],
      "properties": {
        "objective": { "type": "string" },
        "nonGoals": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "authority": { "type": "object" },
        "approval": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "state", "dependencies", "ownership", "acceptanceCriteria", "reasoning", "attempts", "maxAttempts", "receipts", "stateHistory"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["scout", "execute", "integrate", "test", "report"] },
          "state": { "enum": ["PROPOSED", "READY", "DISCUSSING", "RUNNING", "EVIDENCE_PENDING", "PASSED", "FAILED", "REOPENED", "BLOCKED", "INVALIDATED"] },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "ownership": { "type": "array", "items": { "type": "string" } },
          "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
          "reasoning": { "enum": ["low", "medium", "high", "xhigh"] },
          "attempts": { "type": "integer", "minimum": 0 },
          "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
          "receipts": { "type": "array", "items": { "type": "string" } },
          "stateHistory": { "type": "array" }
        },
        "additionalProperties": true
      }
    },
    "evidence": { "type": "array" },
    "artifacts": { "type": "array" },
    "stateHistory": { "type": "array" },
    "graphVersions": { "type": "array", "minItems": 1 },
    "report": {
      "type": "object",
      "required": ["presentation"],
      "properties": {
        "presentation": { "type": ["object", "null"] }
      }
    },
    "extensions": { "type": "object" }
  },
  "additionalProperties": true
}
