{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "objective", "allowed_paths", "non_goals", "repository", "base", "route", "checks", "git_authority"],
  "properties": {
    "package_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "repository": { "type": "string", "minLength": 1 },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "topology", "branch"],
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "topology": { "enum": ["independent", "stacked"] },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reason"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "git_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "push", "pr"],
      "properties": {
        "commit": { "type": "boolean" },
        "push": { "type": "boolean" },
        "pr": { "type": "boolean" }
      }
    },
    "controller_owned_proof": { "type": "array", "items": { "type": "string" } }
  }
}
